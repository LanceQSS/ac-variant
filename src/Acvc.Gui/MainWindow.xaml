<ui:FluentWindow x:Class="Acvc.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="AC Variant" Height="880" Width="1380" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="AC Variant" />
    <Grid Grid.Row="1" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="480" />
        </Grid.ColumnDefinitions>

        <!-- ============ Car picker ============ -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="AcPathButton" DockPanel.Dock="Right" Content="…" Padding="10,2"
                            Click="OnPickAcPath" ToolTip="Change Assetto Corsa install folder" />
                    <TextBlock x:Name="AcPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Opacity="0.8" FontSize="12" />
                </DockPanel>
                <ui:TextBox x:Name="SearchBox" Margin="0,0,0,6" PlaceholderText="Search cars…"
                            TextChanged="OnSearchChanged" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" x:Name="StatusTextBlock" Margin="0,6,0,0"
                       FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
            <ListView x:Name="CarList" SelectionChanged="OnCarSelected">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                    Background="#33888888">
                                <TextBlock Text="{Binding Badge}" FontSize="11" />
                            </Border>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <!-- ============ Transform controls ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Tune name" Width="110" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" x:Name="TuneNameErrorText" Foreground="#FF8888"
                               VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" />
                    <ui:TextBox x:Name="TuneNameBox" PlaceholderText="e.g. street_600"
                                TextChanged="OnAnyControlChanged" />
                </DockPanel>

                <GroupBox Header="Power &amp; Drivetrain" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Power scale" Width="110" VerticalAlignment="Center" />
                            <ui:TextBox x:Name="PowerScaleBox" DockPanel.Dock="Right" Width="90"
                                        TextAlignment="Right" TextChanged="OnScaleBoxChanged"
                                        ToolTip="Type any value — the slider range is just a convenience" />
                            <Slider x:Name="PowerScaleSlider" Minimum="0.5" Maximum="2.5" Value="1.0"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAnyControlChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Rev limiter" Width="110" VerticalAlignment="Center" />
                            <TextBlock x:Name="LimiterStock" DockPanel.Dock="Right" Width="220" Opacity="0.7"
                                       VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                            <TextBox x:Name="LimiterBox" Width="110" HorizontalAlignment="Left"
                                     TextChanged="OnAnyControlChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Boost max / WG" Width="110" VerticalAlignment="Center" />
                            <TextBlock x:Name="BoostStock" DockPanel.Dock="Right" Width="220" Opacity="0.7"
                                       VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="BoostMaxBox" Width="70" TextChanged="OnAnyControlChanged" />
                                <TextBox x:Name="BoostWastegateBox" Width="70" Margin="6,0,0,0"
                                         TextChanged="OnAnyControlChanged" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Final drive" Width="110" VerticalAlignment="Center" />
                            <TextBlock x:Name="FinalStock" DockPanel.Dock="Right" Width="220" Opacity="0.7"
                                       VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                            <TextBox x:Name="FinalBox" Width="110" HorizontalAlignment="Left"
                                     TextChanged="OnAnyControlChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Mass (kg)" Width="110" VerticalAlignment="Center" />
                            <TextBlock x:Name="MassStock" DockPanel.Dock="Right" Width="220" Opacity="0.7"
                                       VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                            <TextBox x:Name="MassBox" Width="110" HorizontalAlignment="Left"
                                     TextChanged="OnAnyControlChanged" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Handling" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Grip scale" Width="110" VerticalAlignment="Center" />
                            <ui:TextBox x:Name="GripScaleBox" DockPanel.Dock="Right" Width="90"
                                        TextAlignment="Right" TextChanged="OnScaleBoxChanged"
                                        ToolTip="Type any value — the slider range is just a convenience" />
                            <Slider x:Name="GripSlider" Minimum="0.6" Maximum="1.4" Value="1.0"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAnyControlChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Brake torque" Width="110" VerticalAlignment="Center" />
                            <ui:TextBox x:Name="BrakeScaleBox" DockPanel.Dock="Right" Width="90"
                                        TextAlignment="Right" TextChanged="OnScaleBoxChanged"
                                        ToolTip="Type any value — the slider range is just a convenience" />
                            <Slider x:Name="BrakeSlider" Minimum="0.3" Maximum="1.8" Value="1.0"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAnyControlChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Diff power" Width="110" VerticalAlignment="Center" />
                            <TextBlock x:Name="DiffPowerValue" DockPanel.Dock="Right" Width="120"
                                       VerticalAlignment="Center" TextAlignment="Right" />
                            <Slider x:Name="DiffPowerSlider" Minimum="0" Maximum="1" Value="0"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAnyControlChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Diff coast" Width="110" VerticalAlignment="Center" />
                            <TextBlock x:Name="DiffStock" DockPanel.Dock="Right" Width="220" Opacity="0.7"
                                       VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                            <Slider x:Name="DiffCoastSlider" Minimum="0" Maximum="1" Value="0"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAnyControlChanged" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="LoadedExtrasText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Preview pane ============ -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom">
                <ItemsControl x:Name="ValidationList" Margin="0,6,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Margin="0,1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E8C36A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                <Setter Property="Foreground" Value="#FF7B7B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="SpecPreview" Height="150" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Save spec…" Click="OnSaveSpec" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="Load spec…" Click="OnLoadSpec" />
                    <Button Grid.Column="3" Content="Logs" Click="OnOpenLogs" Margin="0,0,6,0"
                            ToolTip="Open the build log folder (for bug reports)" />
                    <Button Grid.Column="4" x:Name="BuildButton" Content="Build" Padding="24,4"
                            FontWeight="SemiBold" Click="OnBuild" />
                </Grid>
                <ProgressBar x:Name="BusyBar" Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="Collapsed" />
                <Border x:Name="Toast" Visibility="Collapsed" Background="#2E4B2E" CornerRadius="6"
                        Padding="10" Margin="0,8,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open variant folder" Click="OnOpenVariant"
                                Margin="8,0,0,0" />
                        <TextBlock x:Name="ToastText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </StackPanel>
            <StackPanel>
                <scottplot:WpfPlot x:Name="DynoPlot" Height="330" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="stock" Opacity="0.7" FontSize="12" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="tuned" Opacity="0.7" FontSize="12" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="delta" Opacity="0.7" FontSize="12" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Power" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BhpStock" />
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="BhpTuned" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="BhpDelta" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Torque" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TorqueStock" />
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TorqueTuned" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TorqueDelta" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Weight" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="WeightStock" />
                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="WeightTuned" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Pw ratio" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PwStock" />
                    <TextBlock Grid.Row="4" Grid.Column="2" x:Name="PwTuned" FontWeight="SemiBold" />
                </Grid>
            </StackPanel>
        </DockPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
